# Telegram
TELEGRAM_BOT_TOKEN=
# Кто может пользоваться ботом: chat_id через запятую. Пусто = открыт всем.
# Важно: без ограничения любой чужой человек тратит токены на ТВОЙ ключ модели.
ALLOWED_CHAT_IDS=

# ── Модель ──────────────────────────────────────────────
# Вариант A (как в курсе) — RouterAI:
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
# Вариант B — OpenRouter: задай OPENROUTER_API_KEY и НЕ задавай ROUTERAI_BASE_URL
# OPENROUTER_API_KEY=
#
# необязательно, по умолчанию openai/gpt-5-mini
AGENT_MODEL=openai/gpt-5-mini

# ── Напоминания ─────────────────────────────────────────
# Дефолты для новых пользователей (каждый меняет в чате).
# За сколько дней предупреждать: "3" или "7,3,1"
REMIND_DAYS_BEFORE=3
# Час рассылки по МСК (0..23) — тоже дефолт, пользователь ставит свой фразой «присылай в 20:00»
NOTIFY_HOUR=9

# Путь к базе
BIRTHDAY_DB=birthdays.sqlite3

# ── LangSmith (трейсинг, необязательно) ─────────────────
# Ничего в коде настраивать не нужно — трейсинг включается этими переменными.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=birthday-bot
